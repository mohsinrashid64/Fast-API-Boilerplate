# Copy to `.env` and fill in. Never commit `.env`.

# --- App ---
APP_NAME="FastAPI Async Boilerplate"
ENVIRONMENT=development          # development | production
DEBUG=true
HOST=127.0.0.1
PORT=8000
WORKERS=4
CORS_ORIGINS=http://localhost:3000   # comma separated, or *
FRONTEND_URL=http://localhost:3000   # used in password-reset links

# --- Security ---
# Generated automatically into .env on first start (outside production) if left empty.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Leave empty to configure it from the browser: the app opens a setup wizard at /setup.
DATABASE_URL=
# DATABASE_URL=sqlite+aiosqlite:///./power.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
DB_ECHO=false

# --- Database setup from the UI (defaults: on outside production, off in production) ---
# ALLOW_SETUP_WIZARD=true
# ALLOW_DB_SWITCH=true
# SETUP_ALLOW_REMOTE=false     # /setup only answers requests from localhost

# --- Email (SMTP). If unset in development, emails are logged instead of sent. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_CHECK_MX=true

# --- SMS (AWS SNS). If unset in development, SMS are logged instead of sent. ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
